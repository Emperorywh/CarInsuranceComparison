{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "车险报价对比助手 MVP 验收样本标注 manifest",
  "description": "描述验收样本与其期望抽取结果。manifest 只允许包含匿名样本 ID 与业务期望值（金额/保额/状态），绝不包含姓名、车牌、VIN、发动机号、身份证号、手机号等个人信息；真实隐私探针放在 gitignore 的 samples/probes/ 下，仅用于验收时的隐私回归断言。",
  "type": "object",
  "required": ["schemaVersion", "samples"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "notes": { "type": "string" },
    "samples": {
      "type": "array",
      "items": { "$ref": "#/$defs/sample" }
    }
  },
  "$defs": {
    "sample": {
      "type": "object",
      "required": ["id", "insurer", "files", "expected"],
      "properties": {
        "id": { "type": "string", "pattern": "^S[0-9]{2,}$", "description": "匿名样本 ID，报告中只使用该 ID" },
        "insurer": { "enum": ["PICC", "PINGAN", "CPIC", "CHINALIFE_PC", "GUOYUAN", "DADI", "SUNSHINE", "ZHONGAN", "OTHER"], "description": "用户预选的保险公司码（同时也是期望识别结果）" },
        "files": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "samples/ 目录下的文件名（多文件组按上传顺序排列）" },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "样本构成标签：multi_file / multi_plan / annotation_red_text / annotation_arrow / annotation_handwritten / pdf" },
        "expected": { "$ref": "#/$defs/expected" }
      }
    },
    "expected": {
      "type": "object",
      "description": "人工标注的期望结果；所有键均可省略，省略的字段不参与正确率统计。",
      "properties": {
        "vehicle": {
          "type": "object",
          "properties": {
            "seatCount": { "type": "integer", "minimum": 1, "maximum": 99 },
            "isNev": { "type": "boolean" },
            "firstRegDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" }
          }
        },
        "pricing": {
          "type": "object",
          "description": "价格分项期望值（元）。absent=true 表示报价单明确不含该项（模型应为 NOT_INCLUDED/无值）。",
          "properties": {
            "commercialPremium": { "type": ["number", "null"] },
            "compulsoryPremium": { "type": ["number", "null"] },
            "vehicleTax": { "type": ["number", "null"] },
            "packageTotal": { "type": ["number", "null"] },
            "otherFees": { "type": ["number", "null"] },
            "officialTotal": { "type": ["number", "null"] }
          }
        },
        "coreCoverages": {
          "type": "object",
          "description": "商业四大主险期望；键为标准险种码。",
          "propertyNames": { "enum": ["VEHICLE_LOSS", "THIRD_PARTY_LIABILITY", "DRIVER_LIABILITY", "PASSENGER_LIABILITY"] },
          "additionalProperties": { "$ref": "#/$defs/coverageExpectation" }
        },
        "additionalCoverages": {
          "type": "object",
          "description": "附加险期望；键为标准险种码。absent=true 表示该险种在本报价中不包含。",
          "additionalProperties": { "$ref": "#/$defs/coverageExpectation" }
        },
        "services": {
          "type": "object",
          "description": "增值服务期望；键为服务类型码。明确 0 元必须标注 status=FREE（高风险错误 #5 的判定基准）。",
          "propertyNames": { "enum": ["ROAD_RESCUE", "INSPECTION", "DRIVER_SERVICE", "INSPECTION_AGENT", "OTHER"] },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "absent": { "type": "boolean" },
              "status": { "enum": ["INCLUDED", "NOT_INCLUDED", "FREE", "NOT_APPLICABLE", "UNKNOWN"] },
              "count": { "type": ["integer", "null"] },
              "cost": { "type": ["number", "null"] }
            }
          }
        },
        "packages": {
          "type": "array",
          "description": "独立保障包期望（按名称对齐）。",
          "items": {
            "type": "object",
            "required": ["nameContains", "premium"],
            "properties": {
              "nameContains": { "type": "string", "description": "包名包含的稳定关键词（不含公司名等可变前缀）" },
              "premium": { "type": "number" }
            }
          }
        },
        "annotationProbes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "销售标注文本探针（红字/箭头/手写中的稳定短语）。这些内容允许出现在 sales_annotation，但绝不允许出现在正式险种/价格/服务行中（高风险错误 #4 的判定基准）。探针为业务短语，不含个人信息，可提交。"
        }
      }
    },
    "coverageExpectation": {
      "type": "object",
      "properties": {
        "absent": { "type": "boolean", "description": "true=该险种在本报价中不包含（不存在 INCLUDED 行）" },
        "status": { "enum": ["INCLUDED", "NOT_INCLUDED", "FREE", "NOT_APPLICABLE", "UNKNOWN"] },
        "coverageAmount": { "type": ["number", "null"], "description": "保额（元）；null/省略=不参与该字段正确率统计（如“共享保额”等无法安全换算的文本）" },
        "perSeatAmount": { "type": ["number", "null"] },
        "seatCount": { "type": ["integer", "null"] },
        "premium": { "type": ["number", "null"] }
      }
    }
  }
}
