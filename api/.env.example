# ===================================
# 车险报价对比助手 - 环境变量模板
# 复制为 .env 后按需修改；.env 永远不进入版本控制
# 本模板同时被后端（api/）与前端（web/）读取约定引用
# ===================================

# ---- 数据库 ----
# 默认对接 Docker compose（仓库根目录 docker compose up -d）：
# 宿主机 5433 映射容器 5432，避免与本机已有 PostgreSQL 冲突
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/car_insurance
# 本机未装 Docker 时，可改用已安装的原生 PostgreSQL（默认端口 5432），
# 需先手动建库：psql -U postgres -c "CREATE DATABASE car_insurance;"
# DATABASE_URL=postgresql+asyncpg://postgres:<你的密码>@127.0.0.1:5432/car_insurance
# 注意：连接串必须以 postgresql+asyncpg:// 开头，否则后端拒绝启动；
# 两处（仓库根 .env 或 api/.env）都未配置时，后端回退到上面的 5433 默认值

# ---- 上传文件存储 ----
# 相对仓库根目录解析；该目录整体被 gitignore，包含用户隐私原文件
UPLOAD_DIR=./api/uploads

# ---- 视觉模型供应商（OpenAI 兼容端点）----
# MVP 解析阶段（TASK-03/04）才会真正使用；密钥绝不提交
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=glm-4.5v
# 思考模式：默认 disabled（结构化抽取不需要长推理，长思考链增加耗时与 JSON 失稳风险）；
# 非智谱兼容端点若对未知参数报 400，请清空该行（空=不下发，走模型默认）
VISION_THINKING=disabled

# ---- 上传限制（超出即拒绝，防滥用与解压炸弹）----
MAX_FILE_SIZE_MB=20
MAX_TOTAL_UPLOAD_MB=60
MAX_FILES_PER_QUOTE=12
MAX_PDF_PAGES=10
MAX_TOTAL_PAGES_PER_QUOTE=12
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_LONG_EDGE=2400

# ---- 服务绑定与访问控制 ----
# 默认仅本机访问；改为非回环地址（如 0.0.0.0 / 192.168.x.x）时必须设置 LOCAL_ACCESS_TOKEN，
# 否则后端会拒绝启动（隐私边界：原文件与 API 不允许无保护暴露到局域网）
APP_BIND_HOST=127.0.0.1
LOCAL_ACCESS_TOKEN=
# 令牌模式启用后，除健康检查外的全部 API、原文件与交互文档都要求 X-Access-Token 请求头
# CORS 来源，逗号分隔；局域网部署时必须加入手机实际访问的 origin（如 http://192.168.1.5:3000）
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- 总额校验容差（元）：吸收报价单四舍五入误差 ----
TOTAL_CHECK_TOLERANCE=0.50

# ---- 前端（web/）----
# 浏览器访问后端的基地址；手机局域网访问时应改为电脑的局域网 IP
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# ---- 测试与验收（TASK-07；正式部署保持留空/注释）----
# Playwright E2E 与真实样本验收运行器使用的外部 PostgreSQL 连接串
# （运行器会自行创建/销毁一次性库，不触碰此处指向的库本身）
# E2E_DATABASE_URL=postgresql://postgres:<密码>@<主机>:5432/<库>
# 仅测试可启用的假视觉模型目录（端到端测试注入）；正式部署绝不配置，
# 否则解析结果为固定测试数据。见 api/app/services/parser/fixture_client.py
# VISION_FIXTURE_DIR=
